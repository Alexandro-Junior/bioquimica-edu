<!--
  Inserido pelo Buildozer dentro de <manifest> (android.extra_manifest_xml).

  A partir do Android 11, um app só enxerga outros apps e serviços que
  declara aqui. Não é permissão: não dá acesso a dados de ninguém.
-->
<queries>
    <!-- leitura em voz alta: encontrar o mecanismo de voz do sistema -->
    <intent>
        <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- abrir endereços https (tradução para Libras, fontes, vídeos) no navegador -->
    <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:scheme="https" />
    </intent>
</queries>
