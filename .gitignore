# Preferências de acessibilidade da versão mobile rodando no computador
data/preferencias_mobile.json

# Chaves e credenciais nunca entram no repositório (público). Se o app um
# dia usar uma API de nuvem, a chave fica no servidor intermediário, lida
# de variável de ambiente; localmente, num .env fora do controle de versão.
.env
.env.*
*.pem
google-services.json
GoogleService-Info.plist
client_secret*.json
data/progresso.json

# Configuração local: tudo em config/ fica fora do Git, menos o modelo.
# firebase.json (login com Google) e tutor_nuvem.json (endereço do servidor do
# tutor, fora do GitHub para não expor a cota gratuita).
config/*
!config/firebase.exemplo.json

# Login com Google: sessão do computador; chaves de assinatura do APK
data/sessao_google.dat
data/sessao_google.tmp
*.p12
*.jks

# Progresso: gravação em andamento e arquivo ilegível posto de lado
data/*.tmp
data/progresso.ilegivel-*.json

# Cloudflare (wrangler) e Firebase CLI
.dev.vars
.wrangler/
.firebase/

# Node: o gerador do relatório usa o pacote docx instalado à parte
node_modules/
package.json
package-lock.json

# Claude Code: configurações locais e cópias de trabalho dos revisores
.claude/settings.local.json
.claude/worktrees/
